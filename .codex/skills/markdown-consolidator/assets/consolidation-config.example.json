{
  "source_root": "docs/sources",
  "include": [
    "**/*.md"
  ],
  "exclude": [
    ".git/**",
    ".agents/**",
    ".codex/**",
    "node_modules/**",
    ".markdown-consolidator-work/**",
    ".consolidation/**",
    "output/**"
  ],
  "output_document": "output/consolidated.md",
  "work_directory": "output/.markdown-consolidator-work",
  "audience": "software developers",
  "detail_level": "exhaustive-lossless",
  "publication_source_attribution": "none",
  "internal_traceability": "coverage-map",
  "preserve_external_references_from_content": true,
  "conflict_policy": "preserve-all-evidence-without-file-labels",
  "require_source_line_coverage": 1.0,
  "require_unit_disposition_coverage": 1.0,
  "require_unit_final_representation_coverage": 1.0,
  "require_input_source_reference_violations": 0,
  "maximum_repair_iterations": 3,
  "cleanup_work_directory_after_success": false,
  "require_publication_evidence_coverage": 1.0,
  "require_example_exposition_coverage": 1.0,
  "require_meta_source_phrase_violations": 0,
  "execution_mode": "subagents-required",
  "main_agent_role": "orchestrator-only",
  "allow_main_thread_semantic_fallback": false,
  "require_delegation_validation": true,
  "minimum_validator_subagents": 2
}
