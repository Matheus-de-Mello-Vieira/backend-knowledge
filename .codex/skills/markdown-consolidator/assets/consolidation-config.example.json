{
  "publication_mode": "standalone",
  "source_root": "docs/sources",
  "repository_root": null,
  "include": [
    "**/*.md"
  ],
  "exclude": [
    ".git/**",
    ".agents/**",
    ".codex/**",
    "node_modules/**",
    ".markdown-consolidator-work/**",
    "output/**"
  ],
  "output_document": "output/consolidated.md",
  "work_directory": "output/.markdown-consolidator-work",
  "companion_skill_paths": {
    "note_home_finder": null,
    "markdown_link_normalizer": null
  },
  "maximum_concurrent_subagents": 3,
  "maximum_sources_per_extraction_batch": 1,
  "maximum_topics_per_comparison_batch": 4,
  "maximum_conflicts_per_resolution_batch": 4,
  "maximum_repair_iterations": 3,
  "publication_context": {
    "audience": "software developers",
    "purpose": "operational reference",
    "output_format": "standalone Markdown or repository notes",
    "assumed_knowledge": [
      "basic command-line use"
    ],
    "mandatory_overrides": []
  },
  "detail_level": "exhaustive-lossless",
  "publication_source_attribution": "none",
  "preserve_external_references_from_content": true,
  "preserve_existing_destination_headings": true,
  "modify_context_notes": false,
  "normalize_changed_notes_only": true,
  "validate_full_repository_links": true,
  "cleanup_work_directory_after_success": false,
  "independent_stage_reviews": true,
  "review_batch_size": 3
}
