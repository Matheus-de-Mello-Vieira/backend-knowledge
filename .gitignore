# =============================================================================
# Obsidian
# =============================================================================

# Device-specific UI state
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/workspaces.json

# Obsidian-generated cache/state
.obsidian/cache/
.obsidian/.cache/

# Temporary credential helper generated by obsidian-git
.obsidian/plugins/obsidian-git/.obsidian_askpass.sh

# Machine-specific terminal plugin configuration
.obsidian/plugins/terminal/data.json

# Obsidian trash, if the vault uses the .trash directory
.trash/


# =============================================================================
# Python bytecode and interpreter caches
# =============================================================================

__pycache__/
**/__pycache__/
*.py[cod]
*$py.class

.python_history


